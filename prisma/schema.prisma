// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ShopSettings {
  shop                  String   @id
  // AI provider settings
  aiProvider            String   @default("gemini") // "gemini" or "glm"
  encryptedGeminiApiKey String?
  geminiModel           String   @default("gemini-3.5-flash")
  encryptedGlmApiKey    String?  // Z.ai (Zhipu) API key for GLM models
  glmModel              String   @default("glm-4.5-flash")
  batchSize             Int      @default(30)
  lazyLoadPageSize      Int      @default(20)
  brandName             String?  // brand name to exclude from translation (e.g. "Noonchi Organic")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model TranslationWorkspace {
  id             String              @id @default(cuid())
  shop           String
  themeId        String
  themeName      String
  sourceFilename String
  sourceLocale   String
  targetLocale   String
  sourceSnapshot String
  targetSnapshot String
  statusSnapshot String
  lastSyncedAt   DateTime
  lastUpdatedAt  DateTime            @updatedAt
  createdAt      DateTime            @default(now())
  jobs           TranslationJob[]
  versions       TranslationVersion[]

  @@unique([shop, themeId, sourceFilename, targetLocale])
  @@index([shop, themeId])
}

model TranslationVersion {
  id             String   @id @default(cuid())
  workspaceId    String
  workspace      TranslationWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  targetSnapshot String
  statusSnapshot String
  label          String?
  createdAt      DateTime @default(now())

  @@index([workspaceId, createdAt])
}

model TranslationJob {
  id                   String                @id @default(cuid())
  workspaceId          String
  workspace            TranslationWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  activeKey            String?               @unique
  pendingKeys          Json
  status               String                @default("pending")
  totalItems           Int
  completedItems       Int                   @default(0)
  promptTokenCount     Int                   @default(0)
  candidatesTokenCount Int                   @default(0)
  thoughtsTokenCount   Int                   @default(0)
  totalTokenCount      Int                   @default(0)
  model                String
  error                String?
  processingStartedAt  DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  completedAt          DateTime?

  @@index([workspaceId, status])
}

model ContentTranslationJob {
  id                   String   @id @default(cuid())
  shop                 String
  targetLocale         String
  resourceType         String
  status               String   @default("pending") // pending, active, completed, failed, cancelled
  totalItems           Int      @default(0)
  completedItems       Int      @default(0)
  failedItems          Int      @default(0)
  currentResourceType  String?  // which resource type is currently being processed (for full jobs)
  currentResourceCount Int      @default(0) // how many resources processed in current type
  totalResourceCount   Int      @default(0) // total resources found in current type
  statusMessage        String?  // human-readable detail: "Translating via Gemini...", "Rate limited, waiting 30s...", etc.
  model                String?
  error                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  completedAt          DateTime?

  @@index([shop, status])
  @@index([shop, targetLocale])
}
